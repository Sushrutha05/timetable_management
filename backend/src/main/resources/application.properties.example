# ---------------------------------------------
# SUPABASE DATABASE CONNECTION
# ---------------------------------------------
# Replace values with your Supabase connection details
spring.datasource.url=jdbc:postgresql://[YOUR_HOST]:[YOUR_PORT]/postgres?prepareThreshold=0
spring.datasource.username=[YOUR_USERNAME]
spring.datasource.password=[YOUR_PASSWORD]
spring.datasource.driver-class-name=org.postgresql.Driver


# # fallback to local for development
# spring.datasource.url=${DB_URL_LOCAL:jdbc:postgresql://localhost:5432/}
# spring.datasource.username=${DB_USERNAME_LOCAL}
# spring.datasource.password=${DB_PASSWORD_LOCAL}


# ---------------------------------------------
# SPRING DATA JPA (HIBERNATE) SETTINGS
# ---------------------------------------------

# This shows you the SQL that JPA is running in the console. Very useful for debugging.
spring.jpa.show-sql=true

# This tells Hibernate (the JPA provider) to talk in PostgreSQL language.
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# 'validate' checks if your Java classes match the tables.
# 'update' can make small changes, but 'validate' is safer for production.
# We use 'validate' to force Spring to rely only on Flyway for schema changes.
spring.jpa.hibernate.ddl-auto=validate
# Tells Flyway to accept an existing database as 'V1'
spring.flyway.baseline-on-migrate=true